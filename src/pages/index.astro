---
import Layout from '../layouts/Layout.astro';
import Container from '../components/Container.astro';
import Section from '../components/Section.astro';
import AranduWordmark from '../components/AranduWordmark.astro';
---

<Layout
  title="Leonardo Cardoso | Backend Engineer"
  description="Software engineer with 4+ years of production experience building backend APIs and cloud systems with Python, TypeScript, Rust, and AWS."
>
  <Container>
    <main>
      <header class="hero">
        <AranduWordmark size={32} />
        <h1>Leonardo Cardoso</h1>
        <p class="hero-role">Software engineer focused on backend systems</p>
        <p class="hero-summary">
          I have 4+ years of experience building and maintaining production APIs
          and cloud systems with Python, TypeScript/Node.js, Rust, and AWS.
        </p>
        <p class="hero-availability">
          Based in Brazil. Open to remote roles and contract work.
        </p>
        <nav class="contact-links" aria-label="Contact and professional profiles">
          <a href="mailto:leonardorudolfocardoso@gmail.com">Email →</a>
          <a href="https://www.linkedin.com/in/leonardo-rudolfo-cardoso-a8b420183/" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
          <a href="https://github.com/leonardorudolfocardoso" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
        </nav>
      </header>

      <Section title="Professional experience">
        <div class="experience">
          <article>
            <h3>Arqgen</h3>
            <p class="experience-role">Software Developer · Aug 2022 – Jan 2026</p>
            <p>
              Built and maintained backend services in Python, Node.js, and Rust.
              My work included an async Rust API for warehouse construction
              estimates, parallel AWS Step Functions workflows combining Python
              and Rust, and repeatable deployments with SST.
            </p>
            <p>
              I also developed interactive layout visualization in React and
              investigated backend and frontend bugs in production.
            </p>
          </article>
          <article>
            <h3>Hype Empreendimentos</h3>
            <p class="experience-role">Junior Software Developer · Mar 2021 – Aug 2022</p>
            <p>
              Built a NestJS backend for an investing application, maintained
              internal Node.js APIs, and extended a PostgreSQL-backed ETL pipeline
              with TypeScript and TypeORM.
            </p>
            <p>
              I also developed a Next.js property marketing website with
              API-sourced listings and content managed through Strapi.
            </p>
          </article>
        </div>
      </Section>
    </main>

    <footer class="footer">
      <p>© 2026 Leonardo Cardoso</p>
    </footer>
  </Container>
</Layout>

<style>
  .hero {
    padding-block: 4rem 2rem;
  }

  h1 {
    margin-top: 2rem;
    font-size: clamp(2.2rem, 6vw, 3.5rem);
    font-weight: 600;
    line-height: 1.15;
  }

  .hero-role {
    margin-top: 1rem;
    font-size: clamp(1.1rem, 3vw, 1.4rem);
  }

  .hero-summary {
    max-width: 60ch;
    margin-top: 1.5rem;
    color: var(--color-muted);
    line-height: 1.8;
  }

  .hero-availability {
    margin-top: 1rem;
    color: var(--color-muted);
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    margin-top: 2rem;
  }

  .contact-links a {
    padding-block: 0.5rem;
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 0.3em;
    transition: color var(--transition);
  }

  .contact-links a:hover {
    color: var(--color-text);
  }

  .contact-links a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  .experience {
    display: grid;
    gap: 2.5rem;
    max-width: 65ch;
  }

  .experience h3 {
    font-size: 1.05rem;
    font-weight: 600;
  }

  .experience p {
    margin-top: 0.75rem;
    color: var(--color-muted);
    line-height: 1.8;
  }

  .experience .experience-role {
    margin-top: 0.25rem;
    font-size: 0.85rem;
  }

  .footer {
    padding-block: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }
</style>
